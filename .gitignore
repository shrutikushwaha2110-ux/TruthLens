# Python virtual environment (huge, machine-specific)
backend/.venv/
__pycache__/
*.pyc

# Personal evaluation images — kept local only, never pushed.
# See eval/README.md for what belongs here.
eval/real/*
eval/ai/*
!eval/real/.gitkeep
!eval/ai/.gitkeep

# Claude Code local/machine-specific state (not shared config)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Playwright MCP debug artifacts (regenerated each run)
.playwright-mcp/

# Instagram audit frames — real content from a personal, logged-in feed. Local only,
# never pushed. Only the aggregate findings go into docs/reports.
audit/instagram-frames/
audit/instagram-frames-raw/

# OS files
.DS_Store
Thumbs.db
